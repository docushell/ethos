{
  "schema_version": "1.1.0",
  "config_version": "hardened-v1",
  "claim_kinds": ["quote", "value", "presence", "table_cell"],
  "matching": {
    "text_normalization": "collapse_whitespace",
    "case_sensitive": true,
    "bbox_containment_tolerance_q": 50
  },
  "staleness": {
    "require_fingerprint_match": true
  },
  "limits": {
    "max_checks": 256
  },
  "evidence": {
    "include_text": true,
    "include_crops": false
  },
  "hardening": {
    "include_provenance": true,
    "include_context_echo": true,
    "include_dispersion": true,
    "context_window_chars": 80
  }
}
