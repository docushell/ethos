{
  "name": "@docushell/ethos-mcp",
  "version": "0.3.0",
  "description": "Model Context Protocol server exposing the Ethos document-evidence CLI (verify, parse, chunk, fingerprint) as callable tools.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docushell/ethos.git",
    "directory": "packages/npm/ethos-mcp"
  },
  "bin": {
    "ethos-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts"
  },
  "dependencies": {
    "@docushell/ethos-pdf": "0.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
